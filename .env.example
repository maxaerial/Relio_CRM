# Zugang zur Relio-Supabase. Kopie als .env anlegen und ausfuellen.
# .env ist per .gitignore ausgeschlossen — Keys niemals committen.
#
# Dashboard -> Project Settings -> API Keys -> secret
SUPABASE_SECRET_KEY=
# Dashboard -> Project Settings -> Database -> Connection string -> URI (Session pooler)
SUPABASE_DB_URL=
